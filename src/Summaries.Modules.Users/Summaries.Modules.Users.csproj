<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Summaries.Modules.Users</PackageId>
    <Version>1.0.0</Version>
    <Description>Users feature module: profile management, avatars, two-factor setup, and email sign-in preferences. Has no persistence of its own — everything goes through IIdentityService, implemented by the Authentication module. Depends only on SharedKernel and Shared.Infrastructure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="MediatR" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Summaries.SharedKernel\Summaries.SharedKernel.csproj" />
    <ProjectReference Include="..\Summaries.Shared.Infrastructure\Summaries.Shared.Infrastructure.csproj" />
  </ItemGroup>

</Project>
